{
  "rewrites": [
    {
      "source": "/phonepe",
      "destination": "/api"
    },
    {
      "source": "/phonepe-uat",
      "destination": "/api"
    },
    {
      "source": "/uat",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
